{
    "compilerOptions": {
        "jsx": "react-jsx",
        "allowJs": false,
        "esModuleInterop": false,
        "allowSyntheticDefaultImports": true,
        "strict": true
    },
    "files": [],
    "include": [],
    // `tsc -b` (and so nx's `typecheck` target, which runs it with no argument) builds exactly what
    // is listed here. The spec project is referenced so the 75 spec files are type checked; the
    // storybook project is not, because `*.stories.tsx` carries a known error baseline that
    // .github/workflows/verify.yml records. Storybook itself is Vite-driven and reads
    // tsconfig.storybook.json directly, so it does not need a reference here.
    "references": [
        {
            "path": "./tsconfig.lib.json"
        },
        {
            "path": "./tsconfig.spec.json"
        }
    ],
    "extends": "../../tsconfig.base.json"
}
