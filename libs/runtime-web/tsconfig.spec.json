{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Its own subdirectory: spec projects sharing one `dist/out-tsc` root overwrite each other's
        // declaration output and build info.
        "outDir": "../../dist/out-tsc/runtime-web-spec",
        "types": ["jest", "node"]
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts"],
    // The same sibling projects tsconfig.lib.json references.
    "references": [
        {
            "path": "../storage/tsconfig.lib.json"
        },
        {
            "path": "../session/tsconfig.lib.json"
        },
        {
            "path": "../logger/tsconfig.lib.json"
        },
        {
            "path": "../bridge-messages/tsconfig.lib.json"
        },
        {
            "path": "../bridges/tsconfig.lib.json"
        },
        {
            "path": "../db/tsconfig.lib.json"
        },
        {
            "path": "../runtime-core/tsconfig.lib.json"
        },
        {
            "path": "../data/tsconfig.lib.json"
        }
    ]
}
