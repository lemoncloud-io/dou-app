{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        // No `dom`: this package runs in the native process too, where a page's globals and types do not
        // exist. A page-only name (`document`, `window`, `navigator`, `location`, the IndexedDB types)
        // fails to compile; names React Native also declares still type-check, and the root lint refuses
        // the page globals among them. Node's types stay for the timers, `URL` and `TextEncoder`.
        "lib": ["es2022"],
        "types": ["node"],
        "rootDir": "src",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
    },
    "exclude": [
        "out-tsc",
        "dist",
        "jest.config.ts",
        "jest.config.cts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/__mocks__/**",
        "eslint.config.js",
        "eslint.config.cjs",
        "eslint.config.mjs"
    ],
    "include": ["src/**/*.ts"],
    "references": [
        {
            "path": "../perf/tsconfig.lib.json"
        },
        {
            "path": "../storage/tsconfig.lib.json"
        },
        {
            "path": "../session/tsconfig.lib.json"
        },
        {
            "path": "../data/tsconfig.lib.json"
        },
        {
            "path": "../http/tsconfig.lib.json"
        },
        {
            "path": "../config/tsconfig.lib.json"
        },
        {
            "path": "../logger/tsconfig.lib.json"
        }
    ]
}
