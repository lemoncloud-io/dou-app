{
    "extends": "../../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "types": ["node"],
        "rootDir": "src",
        "jsx": "react-jsx",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
    },
    "exclude": [
        "out-tsc",
        "dist",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.tsx",
        "src/**/*.test.tsx",
        "src/test-setup.ts",
        "eslint.config.mjs"
    ],
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "references": [
        {
            "path": "../../../ui-kit/tsconfig.lib.json"
        }
    ]
}
