{
    "name": "@lemoncloud/chatic-apps-sdk",
    "version": "0.1.0",
    "description": "Build pages that run inside the DoU app",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/lemoncloud-io/dou-app.git",
        "directory": "libs/chatic-apps-sdk"
    },
    "type": "module",
    "sideEffects": false,
    "main": "./index.cjs",
    "module": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./index.d.ts",
                "default": "./index.js"
            },
            "require": {
                "types": "./index.d.cts",
                "default": "./index.cjs"
            }
        },
        "./mock": {
            "import": {
                "types": "./mock.d.ts",
                "default": "./mock.js"
            },
            "require": {
                "types": "./mock.d.cts",
                "default": "./mock.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "unpkg": "./chatic-apps-sdk.global.js",
    "jsdelivr": "./chatic-apps-sdk.global.js",
    "files": ["*.js", "*.cjs", "*.d.ts", "*.d.cts", "README.md", "GUIDE.md", "AGENTS.md"],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {}
}
