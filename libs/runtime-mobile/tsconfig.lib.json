{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        // No `dom` and no Node types: this package runs in React Native's JS process, which is
        // neither. Its globals (`WebSocket`, `fetch`) come from React Native's own types, so a
        // `window`, `document` or `process` here fails to compile instead of failing on a device.
        "lib": ["es2022"],
        "types": [],
        "rootDir": "src",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
    },
    "exclude": [
        "out-tsc",
        "dist",
        "jest.config.ts",
        "jest.config.cts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/__mocks__/**",
        "eslint.config.js",
        "eslint.config.cjs",
        "eslint.config.mjs"
    ],
    "include": ["src/**/*.ts"],
    "references": [
        {
            "path": "../db/tsconfig.lib.json"
        },
        {
            "path": "../data/tsconfig.lib.json"
        },
        {
            "path": "../bridge-messages/tsconfig.lib.json"
        },
        {
            "path": "../runtime-core/tsconfig.lib.json"
        },
        {
            "path": "../storage/tsconfig.lib.json"
        }
    ]
}
