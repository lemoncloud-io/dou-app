{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        // No `dom` and no Node types: the base config gives every project the browser's types, and
        // this package is shared by the web and native runtimes, neither of which is Node. A
        // `window`, `process` or `Buffer` used here fails to compile instead of working in one
        // runtime and failing in the other.
        "lib": ["es2022"],
        "types": [],
        "rootDir": "src",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
    },
    "exclude": [
        "out-tsc",
        "dist",
        "jest.config.ts",
        "jest.config.cts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "src/**/__mocks__/**",
        "eslint.config.js",
        "eslint.config.cjs",
        "eslint.config.mjs"
    ],
    "include": ["src/**/*.ts"],
    "references": [
        {
            "path": "../data/tsconfig.lib.json"
        },
        {
            "path": "../auth/tsconfig.lib.json"
        },
        {
            "path": "../transport/tsconfig.lib.json"
        },
        {
            "path": "../session/tsconfig.lib.json"
        }
    ]
}
