{
    "extends": "./tsconfig.app.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "module": "commonjs",
        "types": ["jest", "node"],
        "rootDir": "."
    },
    // Override app's exclude (which drops *.test/*.spec) so test files belong to this project.
    "exclude": ["out-tsc", "dist"],
    "include": ["jest.config.js", "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"]
}
