VITE_ENV=LOCAL
VITE_PROJECT=CHATIC
VITE_OAUTH_ENDPOINT=https://api.example.com/dou-d1
VITE_HOST=http://localhost:5003
VITE_SOCIAL_OAUTH_ENDPOINT=https://oauth2.example.com
VITE_IMAGE_API_ENDPOINT=https://image.example.com
VITE_BACKEND_ENDPOINT=https://api.example.com/d1
VITE_WS_ENDPOINT=wss://wss.example.com/cht-d1
VITE_DOU_ENDPOINT=https://api.example.com/dou-d1
VITE_ARCHIVE_ENDPOINT=https://api.example.com/arc-d1
VITE_SOC_ENDPOINT=https://api.example.com/soc-d1
VITE_IAP_ENDPOINT=https://api.eureka.codes/iap-d1

# Entry code for the hidden debug overlay (see apps/web/docs/feature/debug/entry-gate.md).
# Fail-closed: unset means the 10-tap gesture never opens the challenge, in any environment.
VITE_DEBUG_CODE=000000

# Set to true to stop the page from asking a phone shell that offers to hold the session: every launch
# is then the page's own (apps/web/docs/bridge/README.md — "The switch"). Unset means the page asks.
# VITE_SESSION_MIRROR_DISABLED=true

# The owner the phone app gives an install nobody switched, from its next start: web or native. Sent on
# every boot; unset clears it, so the app falls back to its own build's default (the app's runtime on a dev or production build, the page on a local one).
# Deploys read it from the WEB_<STAGE>_APP_SESSION_OWNER repository variable.
# VITE_APP_SESSION_OWNER=native

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
