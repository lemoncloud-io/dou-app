{
    "name": "dou-cli",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/dou-cli/src",
    "projectType": "application",
    "tags": ["layer:app", "platform:node", "formfactor:any"],
    "targets": {
        "build-sidecar": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "command": "node apps/dou-cli/scripts/build-sidecar.mjs"
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/dist/apps/dou-cli"],
            "options": {
                "command": "node apps/dou-cli/scripts/build.mjs"
            },
            "inputs": [
                "default",
                "^default",
                {
                    "env": "VITE_FCM_API_KEY"
                },
                {
                    "env": "VITE_FCM_PROJECT_ID"
                },
                {
                    "env": "VITE_FCM_SENDER_ID"
                },
                {
                    "env": "VITE_FCM_APP_ID"
                },
                {
                    "env": "VITE_FCM_PACKAGE"
                }
            ]
        }
    }
}
