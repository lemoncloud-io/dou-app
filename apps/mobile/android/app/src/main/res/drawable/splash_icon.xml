<?xml version="1.0" encoding="utf-8"?>
<!--
  The system lays the SplashScreen icon out in a 108dp box — the adaptive-icon foreground convention —
  and then scales that box by 192/108 into the visible icon area. So the sizes here are 108dp-box
  sizes, not on-screen ones: the logo is declared at 54x48dp to land at 96x85dp, the same size the
  iOS launch screen draws it at. Declaring 96x85 here measured about 170dp wide on screen.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="108dp"
        android:height="108dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="54dp"
        android:height="48dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
