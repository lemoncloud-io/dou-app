# Mobile deploy credentials — copy to apps/mobile/fastlane/.env and fill in.
# The real .env is gitignored; never commit actual values.

# Key files (.p8 / Play JSON) can sit right in this fastlane/ directory —
# they are gitignored here. Bare filenames below resolve against fastlane/;
# absolute and ~ paths also work.

# --- App Store Connect API key (TestFlight upload + iOS cloud signing) ---
# Shared by all apps in the same Apple developer account.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=AuthKey_XXXXXXXX.p8

# Optional: only set these when the dev app lives in a DIFFERENT Apple
# account. When empty, dev deploys fall back to the shared values above.
ASC_KEY_ID_DEV=
ASC_ISSUER_ID_DEV=
ASC_KEY_PATH_DEV=

# --- Google Play service accounts (Play upload) ---
# The dev and prod apps live in DIFFERENT Google Cloud accounts, so both
# keys are required: prod JSON below, dev JSON in the _DEV variable.
PLAY_JSON_KEY_PATH=play-service-account-prod.json
PLAY_JSON_KEY_PATH_DEV=play-service-account-dev.json

# Play tracks: dev app ships to closed testing ("alpha" unless the console
# shows a custom track name), prod app to "internal" before promotion.
PLAY_TRACK_DEV=alpha
PLAY_TRACK_PROD=internal

# Locale used for Play release notes (release notes are written in English).
PLAY_LOCALE=en-US

# --- Android release keystore (read by android/app/build.gradle) ---
# ANDROID_KEYSTORE_FILE resolves relative to android/app; keep the default
# when chatic-dou.keystore sits there, or set an absolute path.
ANDROID_KEYSTORE_FILE=chatic-dou.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=chatic-dou
ANDROID_KEY_PASSWORD=
