use_frameworks! :linkage => :static
use_modular_headers!

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# PoC: react-native-zip-archive(RNZipArchive)가 iOS 15.5를 요구하여 min을 상향
# (RN 0.83 기본 min_ios_version_supported = 15.1)
platform :ios, '15.5'
prepare_react_native_project!

require_relative '../../../node_modules/react-native-permissions/scripts/setup'
setup_permissions([
  'Camera',
  'PhotoLibrary',
  'Contacts',
  'Notifications',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

project 'Chatic',
  'Debug' => :debug,
  'Release' => :release,
  'Debug Dev' => :debug,
  'Release Dev' => :release

target 'Chatic' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # ReactNativeStaticServer(lighttpd)의 CMake 빌드 스크립트가 ${TARGET_TEMP_DIR}/${PODS_TARGET_SRCROOT}를
    # quote 없이 넘겨서, 스킴/설정 이름에 공백이 있는 "Chatic Dev"/"Release Dev" 빌드에서 셸이 경로를
    # 단어 단위로 쪼개고 `cmake --build`가 "Unknown argument ..."로 실패한다. 두 변수를 quote해서 고친다.
    #
    # 그런데 quote만으로는 archive가 여전히 깨진다: TARGET_TEMP_DIR 자체가
    # ArchiveIntermediates/Chatic Dev/.../Release Dev-iphoneos/... 처럼 공백을 포함한 경로라,
    # 그 안에 `-GXcode`로 생성되는 CMake의 중첩 Xcode 프로젝트(lighttpd/mod_h2/...)가 만드는
    # 응답 파일(.resp)이 그 공백을 escape하지 못해 clang이 경로를 단어 단위로 쪼갠다
    # ("no such file or directory: 'Dev/IntermediateBuildFilesPath/...'"). 공백이 없는
    # $TMPDIR 하위로 실제 빌드 디렉터리를 옮겨서 이 문제를 원천 차단한다.
    #
    # 추가로, Xcode GUI에서 빌드하면 스크립트 페이즈의 PATH에 Homebrew 경로가 없어서
    # `cmake: command not found`로 실패한다 (터미널 빌드는 셸 PATH를 물려받아 통과).
    # Homebrew 표준 경로를 PATH 뒤에 붙여서 실행 경로와 무관하게 cmake를 찾게 한다.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'ReactNativeStaticServer'
      target.build_phases.each do |phase|
        next unless phase.respond_to?(:shell_script) && phase.shell_script&.include?('${TARGET_TEMP_DIR}')
        next if phase.shell_script.include?('"${TARGET_TEMP_DIR}"')
        phase.shell_script = phase.shell_script
          .sub(
            'set -e',
            "set -e\n\n" \
            "      # Xcode GUI 빌드의 PATH에는 Homebrew가 없어 cmake를 못 찾는다 — 표준 설치 경로를 추가\n" \
            '      export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"' + "\n\n" \
            "      # 공백 없는 임시 디렉터리로 CMake 빌드 경로를 리다이렉트 (스킴/설정 이름 공백 우회)\n" \
            '      SAFE_CONFIG="$(echo ${CONFIGURATION} | tr -d \' \')"' + "\n" \
            '      TARGET_TEMP_DIR="${TMPDIR%/}/rnss-build-${TARGET_NAME}-${SAFE_CONFIG}-${EFFECTIVE_PLATFORM_NAME}"' + "\n" \
            '      mkdir -p "$TARGET_TEMP_DIR"'
          )
          .gsub('${PODS_TARGET_SRCROOT}', '"${PODS_TARGET_SRCROOT}"')
          .gsub('${TARGET_TEMP_DIR}', '"${TARGET_TEMP_DIR}"')
          .gsub('${BUILT_PRODUCTS_DIR}', '"${BUILT_PRODUCTS_DIR}"')
      end
    end

    # op-sqlite의 헤더 중복 복사 명령만 깔끔하게 찾아내서 하나를 지우는 스크립트
    installer.pods_project.targets.each do |target|
      if target.name.include?('op-sqlite')
        seen_headers = []
        target.headers_build_phase.files.to_a.each do |file|
          if file.file_ref
            # 파일 이름을 안전하게 가져옵니다
            header_name = file.file_ref.name || file.file_ref.path.split('/').last

            # 이미 목록에 있는 헤더(예: libsql.h)라면 중복이므로 제거합니다
            if seen_headers.include?(header_name)
              target.headers_build_phase.remove_build_file(file)
            else
              seen_headers << header_name
            end
          end
        end
      end
    end
  end
end
