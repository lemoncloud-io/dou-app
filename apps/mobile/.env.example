# Template for `apps/mobile/.env` — the LOCAL env, same meaning it has in web / desktop-web /
# admin-v2. Copy it and fill in the blanks:
#
#   cp apps/mobile/.env.example apps/mobile/.env
#
# `.env.dev` and `.env.prod` are the built envs and are chosen by the BUILD CONFIGURATION, not by
# this file — iOS via the per-configuration `ENVFILE` build setting, Android via `envConfigFiles`
# in android/app/build.gradle. Only `mobile:ios:local` / `mobile:android:local` override that to
# read this file. See apps/mobile/docs/local-run.md.

VITE_ENV=LOCAL

# Where the WebView loads the app from. `mobile:*:local` expects the web dev server on 5003;
# Android reaches it through `adb reverse`, so the address is the same on both platforms.
VITE_WEBVIEW_BASE_URL=http://localhost:5003

# Unused: no code reads Config.VITE_WS_ENDPOINT. Kept only so the file matches `.env.dev`/`.env.prod`.
VITE_WS_ENDPOINT=

VITE_SUBSCRIPTION_IAP_SKUS_IOS=
VITE_SUBSCRIPTION_IAP_SKUS_ANDROID=
VITE_SUBSCRIPTION_IAP_PLANS_ANDROID=
VIEW_APP_NAME=DoU_Dev
VITE_GOOGLE_WEB_CLIENT_ID=

# Android Keystore — release builds only; a local run does not need these.
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
