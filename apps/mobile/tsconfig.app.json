{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "types": ["node"],
        "rootDir": "src",
        "jsx": "react-jsx",
        "noUnusedLocals": false,
        "lib": ["dom"],
        "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
    },
    "exclude": [
        "out-tsc",
        "dist",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.test.js",
        "src/**/*.spec.js",
        "src/**/*.test.jsx",
        "src/**/*.spec.jsx",
        "src/test-setup.ts",
        "eslint.config.js",
        "eslint.config.cjs",
        "eslint.config.mjs"
    ],
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx"],
    "references": [
        {
            "path": "../../libs/config/tsconfig.lib.json"
        },
        {
            "path": "../../libs/chatic-apps-sdk/tsconfig.lib.json"
        },
        {
            "path": "../../libs/bridges/tsconfig.lib.json"
        },
        {
            "path": "../../libs/runtime-mobile/tsconfig.lib.json"
        },
        {
            "path": "../../libs/checkout/store/tsconfig.lib.json"
        },
        {
            "path": "../../libs/push/mobile/tsconfig.lib.json"
        },
        {
            "path": "../../libs/sign-in/mobile/tsconfig.lib.json"
        },
        {
            "path": "../../libs/host/mobile/tsconfig.lib.json"
        },
        {
            "path": "../../libs/storage/mmkv/tsconfig.lib.json"
        },
        {
            "path": "../../libs/storage/keychain/tsconfig.lib.json"
        },
        {
            "path": "../../libs/perf/tsconfig.lib.json"
        },
        {
            "path": "../../libs/data/tsconfig.lib.json"
        },
        {
            "path": "../../libs/db/tsconfig.lib.json"
        },
        {
            "path": "../../libs/shared/tsconfig.lib.json"
        },
        {
            "path": "../../libs/mini-app/protocol/tsconfig.lib.json"
        },
        {
