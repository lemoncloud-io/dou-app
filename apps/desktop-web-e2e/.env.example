# Copy to `.env` (git-ignored) and fill in a dev account. Never commit the real values.
DESKTOP_E2E_EMAIL=
DESKTOP_E2E_PASSWORD=
# A workspace cloud of the main account, a place in it where a test channel may be created and
# deleted, and a place there with no channel or DM yet (it opens on the welcome page).
DESKTOP_E2E_CLOUD=
DESKTOP_E2E_PLACE=
DESKTOP_E2E_EMPTY_PLACE=
# The phone number the two-person scenarios invite someone by. Nothing is sent to it: the scenario
# reads the invite link from the server's answer, so a placeholder number does.
DESKTOP_E2E_INVITE_PHONE=01000000000
