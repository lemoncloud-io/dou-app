# Copy to `.env` (git-ignored) and fill in two dev accounts. Never commit the real values.
DESKTOP_E2E_EMAIL=
DESKTOP_E2E_PASSWORD=
# A second account, for what only someone else can cause: a DM to you, a mention, a reply, a reaction.
DESKTOP_E2E_PEER_EMAIL=
DESKTOP_E2E_PEER_PASSWORD=
# A workspace cloud of the main account, a place in it where a test channel may be created and
# deleted, and a place there with no channel or DM yet (it opens on the welcome page).
DESKTOP_E2E_CLOUD=
DESKTOP_E2E_PLACE=
DESKTOP_E2E_EMPTY_PLACE=
