        "outDir": "../../dist/out-tsc/shell-adapter",
        "tsBuildInfoFile": "../../dist/out-tsc/shell-adapter/tsconfig.app.tsbuildinfo",
        "lib": ["es2022", "dom"],
        "types": ["node"],
        "rootDir": "../.."
    },
    "exclude": ["out-tsc", "dist", "src/**/*.spec.ts"],
