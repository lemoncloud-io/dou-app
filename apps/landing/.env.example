# The account surface (/subscription/*) reads these; the public pages read none of them.
# Copy to .env (untracked) with the real dev addresses. Without the four addresses below the
# account surface runs on its in-page mock, as it did before there was a server.
VITE_ENV=DEV
VITE_PROJECT=CHATIC
VITE_OAUTH_ENDPOINT=https://api.example.com/dou-d1
VITE_SOCIAL_OAUTH_ENDPOINT=https://oauth2.example.com
VITE_DOU_ENDPOINT=https://api.example.com/dou-d1
VITE_WS_ENDPOINT=wss://wss.example.com/cht-d1
