{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "DoU Tauri",
    "version": "0.0.1",
    "identifier": "io.chatic.desktop.tauri",
    "build": {
        "frontendDist": "../ui"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* https:"
        }
    },
    "plugins": {
        "deep-link": {
            "desktop": { "schemes": ["chatic", "chatic-dev"] }
        },
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFQTQzQTdCOUUxNTVCNEEKUldSS1d4V2VlenFrUGhLdkZJRUlIZ0Z1OUJTY2xYYW9lUGw5Vm1TaXRKc2tNanZnMlpnbVNLYVgK",
            "endpoints": [],
            "requireSignedVersion": true
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]    }
}
