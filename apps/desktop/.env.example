# Desktop Shell (Electron) build-time config.
# Baked into the main bundle by electron-vite (MAIN_VITE_* -> import.meta.env). See ADR-0001/0003.
#
# Per-mode files: .env.dev (packaged dev), .env.production (packaged prod).
# Local `electron-vite dev` leaves this unset and falls back to the local desktop-web server (:5005).
MAIN_VITE_DESKTOP_WEB_URL=https://desktop.dou.chatic.io/index.html

# Cross-cloud push (FCM, via @liamcottle/push-receiver). Firebase client config — NOT
# committed (public OSS repo). CI injects these from FIREBASE_*/FIREBASE_*_ANDROID_APP_ID
# secrets (.github/workflows/build-desktop.yml). For a LOCAL build that exercises push,
# copy these into a gitignored .env.dev.local / .env.production.local with real values
# (from apps/mobile/.../google-services.json — the android client block):
MAIN_VITE_FCM_API_KEY=
MAIN_VITE_FCM_PROJECT_ID=
MAIN_VITE_FCM_SENDER_ID=
MAIN_VITE_FCM_APP_ID=          # the android appId (1:<sender>:android:<hash>), not the web one
MAIN_VITE_FCM_PACKAGE=         # io.chatic.dou.dev (dev) / io.chatic.dou (prod)
