# Desktop Shell (Electron) build-time config.
# Baked into the main bundle by electron-vite (MAIN_VITE_* -> import.meta.env). See ADR-0001/0003.
#
# Per-mode files: .env.dev (packaged dev), .env.production (packaged prod).
# Local `electron-vite dev` leaves this unset and falls back to the local desktop-web server (:5005).
MAIN_VITE_DESKTOP_WEB_URL=https://desktop.dou.chatic.io/index.html
