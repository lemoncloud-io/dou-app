{
    "name": "@chatic/desktop",
    "version": "0.0.13",
    "private": true,
    "description": "Chatic desktop shell (Electron)",
    "author": "lemoncloud",
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "start": "electron-vite preview",
        "typecheck": "tsc -b tsconfig.json",
        "test": "jest",
        "build:dev": "electron-vite build --mode dev",
        "build:prod": "electron-vite build --mode production",
        "package:mac:dev": "yarn build:dev && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config electron-builder.dev.json",
        "package:mac:prod": "yarn build:prod && electron-builder --mac",
        "package:mac:prod:signed": "yarn build:prod && dotenv -e .env.signing -- electron-builder --mac -c.mac.notarize=true",
        "package:win:dev": "yarn build:dev && electron-builder --win --config electron-builder.dev.json",
        "package:win:prod": "yarn build:prod && electron-builder --win"
    },
    "dependencies": {
        "@liamcottle/push-receiver": "^0.0.4",
        "electron-updater": "^6.3.9"
    },
    "devDependencies": {
        "electron": "33.4.11",
        "electron-builder": "^25.1.8",
        "electron-vite": "^5.0.0"
    },
    "build": {
        "extends": "./electron-builder.base.json",
        "protocols": [
            {
                "name": "DoU Protocol",
                "schemes": [
                    "chatic"
                ]
            }
        ],
        "publish": [
            {
                "provider": "generic",
                "url": "https://desktop.dou.chatic.io/updates"
            }
        ]
    }
}
