# Packaged DEV shell — loads the deployed dev Desktop Web (ADR-0001/0003).
MAIN_VITE_DESKTOP_WEB_URL=https://desktop.dou-dev.chatic.io/index.html
# Dev channel: isolates app name, userData, and the deeplink protocol (chatic-dev:)
# so the dev app and the installed production DoU never collide.
MAIN_VITE_CHANNEL=dev

# Cross-cloud push: FCM (Android registration via push-receiver) — dev project lemondu-ecb38.
# Firebase client config is NOT committed (public OSS repo) — CI injects MAIN_VITE_FCM_*
# from the FIREBASE_DEV_* secrets (see .github/workflows/build-desktop.yml). For a local
# build with push, put the values in apps/desktop/.env.dev.local (gitignored) — see .env.example.
