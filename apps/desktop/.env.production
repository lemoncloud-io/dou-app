# Packaged PROD shell — loads the deployed prod Desktop Web (ADR-0001/0003).
MAIN_VITE_DESKTOP_WEB_URL=https://desktop.dou.chatic.io/

# Cross-cloud push: FCM (Android registration via push-receiver) — prod project chaticdou.
# Firebase client config is NOT committed (public OSS repo) — CI injects MAIN_VITE_FCM_*
# from the FIREBASE_PROD_* secrets (see .github/workflows/build-desktop.yml). For a local
# build with push, put the values in apps/desktop/.env.production.local (gitignored).
