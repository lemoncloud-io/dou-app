{
    "name": "chatic-apps-example",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/chatic-apps-example/src",
    "projectType": "application",
    "tags": [],
    "targets": {
        "bundle": {
            "executor": "nx:run-commands",
            "dependsOn": ["build"],
            "outputs": ["{workspaceRoot}/dist/apps/chatic-apps-example.zip"],
            "options": {
                "cwd": "apps/chatic-apps-example",
                "command": "node scripts/zip-bundle.mjs ../../dist/apps/chatic-apps-example ../../dist/apps/chatic-apps-example.zip"
            }
        },
        "check": {
            "executor": "nx:run-commands",
            "dependsOn": ["build", "@chatic/chatic-apps-devtools:build"],
            "options": {
                "cwd": "apps/chatic-apps-example",
                "command": "node ../../dist/libs/chatic-apps-devtools/cli.js check --dist ../../dist/apps/chatic-apps-example"
            }
        },
        "scenarios": {
            "executor": "nx:run-commands",
            "dependsOn": ["build", "@chatic/chatic-apps-devtools:build"],
            "options": {
                "cwd": "apps/chatic-apps-example",
                "command": "node ../../dist/libs/chatic-apps-devtools/cli.js scenarios --dist ../../dist/apps/chatic-apps-example --mock @chatic/chatic-apps-sdk/mock"
            }
        }
    }
}
