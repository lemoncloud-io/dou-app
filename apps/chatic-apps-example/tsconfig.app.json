{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "out-tsc",
        "tsBuildInfoFile": "out-tsc/tsconfig.app.tsbuildinfo",
        "lib": ["ES2022", "DOM"],
        "types": ["vite/client"],
        "resolveJsonModule": true
    },
    "exclude": ["out-tsc", "dist"],
    "include": ["src/**/*.ts", "public/.well-known/chatic-app.json", "chatic-apps.scenarios.ts"],
    "references": [
        {
            "path": "../../libs/chatic-apps-sdk/tsconfig.lib.json"
        },
        {
            "path": "../../libs/chatic-apps-devtools/tsconfig.lib.json"
        }
    ]
}
