{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node -e \"const{spawnSync:s}=require('child_process'),f=require('fs'),p=require('path');const i=f.readFileSync(0);let c;try{c=JSON.parse(i).cwd}catch{}const t=(s('git',['-C',c||'.','rev-parse','--show-toplevel'],{encoding:'utf8'}).stdout||'').trim();const h=p.join(t,'.claude','hooks',process.argv[1]+'.cjs');if(!t||!f.existsSync(h))process.exit(0);const r=s(process.execPath,[h],{input:i,stdio:['pipe','inherit','inherit'],cwd:t,env:{...process.env,CLAUDE_PROJECT_DIR:t}});process.exit(r.status===null?1:r.status)\" lint-edited-file",
                        "timeout": 90
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node -e \"const{spawnSync:s}=require('child_process'),f=require('fs'),p=require('path');const i=f.readFileSync(0);let c;try{c=JSON.parse(i).cwd}catch{}const t=(s('git',['-C',c||'.','rev-parse','--show-toplevel'],{encoding:'utf8'}).stdout||'').trim();const h=p.join(t,'.claude','hooks',process.argv[1]+'.cjs');if(!t||!f.existsSync(h))process.exit(0);const r=s(process.execPath,[h],{input:i,stdio:['pipe','inherit','inherit'],cwd:t,env:{...process.env,CLAUDE_PROJECT_DIR:t}});process.exit(r.status===null?1:r.status)\" check-escalation",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node -e \"const{spawnSync:s}=require('child_process'),f=require('fs'),p=require('path');const i=f.readFileSync(0);let c;try{c=JSON.parse(i).cwd}catch{}const t=(s('git',['-C',c||'.','rev-parse','--show-toplevel'],{encoding:'utf8'}).stdout||'').trim();const h=p.join(t,'.claude','hooks',process.argv[1]+'.cjs');if(!t||!f.existsSync(h))process.exit(0);const r=s(process.execPath,[h],{input:i,stdio:['pipe','inherit','inherit'],cwd:t,env:{...process.env,CLAUDE_PROJECT_DIR:t}});process.exit(r.status===null?1:r.status)\" check-escalation",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "command": "node -e \"const{spawnSync:s}=require('child_process'),f=require('fs'),p=require('path');const i=f.readFileSync(0);let c;try{c=JSON.parse(i).cwd}catch{}const t=(s('git',['-C',c||'.','rev-parse','--show-toplevel'],{encoding:'utf8'}).stdout||'').trim();const h=p.join(t,'.claude','hooks',process.argv[1]+'.cjs');if(!t||!f.existsSync(h))process.exit(0);const r=s(process.execPath,[h],{input:i,stdio:['pipe','inherit','inherit'],cwd:t,env:{...process.env,CLAUDE_PROJECT_DIR:t}});process.exit(r.status===null?1:r.status)\" gate-before-commit",
                        "timeout": 1800
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node -e \"const{spawnSync:s}=require('child_process'),f=require('fs'),p=require('path');const i=f.readFileSync(0);let c;try{c=JSON.parse(i).cwd}catch{}const t=(s('git',['-C',c||'.','rev-parse','--show-toplevel'],{encoding:'utf8'}).stdout||'').trim();const h=p.join(t,'.claude','hooks',process.argv[1]+'.cjs');if(!t||!f.existsSync(h))process.exit(0);const r=s(process.execPath,[h],{input:i,stdio:['pipe','inherit','inherit'],cwd:t,env:{...process.env,CLAUDE_PROJECT_DIR:t}});process.exit(r.status===null?1:r.status)\" verify-before-stop",
                        "timeout": 30
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node -e \"const{spawnSync:s}=require('child_process'),f=require('fs'),p=require('path');const i=f.readFileSync(0);let c;try{c=JSON.parse(i).cwd}catch{}const t=(s('git',['-C',c||'.','rev-parse','--show-toplevel'],{encoding:'utf8'}).stdout||'').trim();const h=p.join(t,'.claude','hooks',process.argv[1]+'.cjs');if(!t||!f.existsSync(h))process.exit(0);const r=s(process.execPath,[h],{input:i,stdio:['pipe','inherit','inherit'],cwd:t,env:{...process.env,CLAUDE_PROJECT_DIR:t}});process.exit(r.status===null?1:r.status)\" check-escalation",
                        "timeout": 10
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node -e \"const{spawnSync:s}=require('child_process'),f=require('fs'),p=require('path');const i=f.readFileSync(0);let c;try{c=JSON.parse(i).cwd}catch{}const t=(s('git',['-C',c||'.','rev-parse','--show-toplevel'],{encoding:'utf8'}).stdout||'').trim();const h=p.join(t,'.claude','hooks',process.argv[1]+'.cjs');if(!t||!f.existsSync(h))process.exit(0);const r=s(process.execPath,[h],{input:i,stdio:['pipe','inherit','inherit'],cwd:t,env:{...process.env,CLAUDE_PROJECT_DIR:t}});process.exit(r.status===null?1:r.status)\" check-escalation",
                        "timeout": 10
                    }
