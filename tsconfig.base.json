{
    "compileOnSave": false,
    "compilerOptions": {
        "composite": true,
        "declarationMap": true,
        "emitDeclarationOnly": true,
        "importHelpers": true,
        "isolatedModules": true,
        "lib": ["es2022", "dom"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmitOnError": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "es2022",
        "customConditions": ["@chatic/source"],
        "rootDir": ".",
        "sourceMap": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "baseUrl": ".",
        "paths": {
            "@chatic/app-messages": ["libs/app-messages/src/index.ts"],
            "@chatic/app-runtime": ["libs/app-runtime/src/index.ts"],
            "@chatic/bridges": ["libs/bridges/src/index.ts"],
            "@chatic/assets": ["assets/src/index.ts"],
            "@chatic/auth-sign": ["libs/auth-sign/src/index.ts"],
            "@chatic/chats": ["libs/chats/src/index.ts"],
            "@chatic/device-utils": ["libs/device-utils/src/index.ts"],
            "@chatic/http": ["libs/http/src/index.ts"],
            "@chatic/i18n-mobile": ["libs/i18n-mobile/src/index.ts"],
            "@chatic/lib/utils": ["libs/ui-kit/src/utils/index.ts"],
            "@chatic/logger": ["libs/logger/src/index.ts"],
            "@chatic/policy-content": ["libs/policy-content/src/index.ts"],
            "@chatic/shared": ["libs/shared/src/index.ts"],
            "@chatic/data": ["libs/data/src/index.ts"],
            "@chatic/db": ["libs/db/src/index.ts"],
            "@chatic/theme": ["libs/theme/src/index.ts"],
            "@chatic/ui-kit": ["libs/ui-kit/src/index.ts"],
            "@chatic/ui-kit/*": ["libs/ui-kit/src/*"],
            "@chatic/web-config": ["libs/web-config/src/index.ts"],
            "@chatic/web-ui-kit": ["libs/web-ui-kit/src/index.ts"],
            "@chatic/web-ui-kit/*": ["libs/web-ui-kit/src/*"]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
